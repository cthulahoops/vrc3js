{
  "name": "vrc3d-threejs-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite",
    "dev:bff": "bun server/index.ts",
    "dump:entities": "bun scripts/dump-entity-types.ts",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "preview": "vite preview --host localhost",
    "verify:screenshot": "tsx scripts/render-verification.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-color-emoji": "^5.3.1",
    "astronomy-engine": "^2.1.19",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "@types/three": "^0.179.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.1.3"
  }
}
